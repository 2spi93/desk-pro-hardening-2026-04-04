{
  "name": "mission-control-ui",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "rm -rf .next",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "build": "next build",
    "start": "next start -p 3000",
    "qa:smoke": "sh scripts/qa-smoke.sh",
    "qa:ui-regression": "sh scripts/qa-regression-ui.sh",
    "qa:ui-regression:chart": "PLAYWRIGHT_TEST_GREP=@chart sh scripts/qa-regression-ui.sh",
    "qa:ui-regression:hud": "PLAYWRIGHT_TEST_PATH=tests/e2e/chart-trading-hud.spec.ts sh scripts/qa-regression-ui.sh",
    "qa:all": "sh scripts/qa-all.sh",
    "qa:real-control-plane": "sh scripts/qa-real-control-plane.sh",
    "qa:real-control-plane:staging": "sh scripts/qa-real-control-plane.sh staging",
    "qa:real-control-plane:prod": "sh scripts/qa-real-control-plane.sh prod",
    "deps:check-next": "sh scripts/check-next-version.sh",
    "test:custom-candle-renderer-guard": "node scripts/test-custom-candle-renderer-guard.js",
    "test:dynamic-candle-presentation-guard": "node scripts/test-dynamic-candle-presentation-guard.js",
    "test:dynamic-candle-scaling-guard": "node scripts/test-dynamic-candle-scaling-guard.js",
    "test:multi-chart-sync-guard": "node scripts/test-multi-chart-sync-guard.js",
    "test:perceptual-candle-engine-guard": "node scripts/test-perceptual-candle-engine-guard.js",
    "test:gpu-orderflow-desk-guard": "node scripts/test-gpu-orderflow-desk-guard.js",
    "test:hft-overlay-guard": "node scripts/test-hft-overlay-guard.js",
    "test:golden-frame-stress": "sh scripts/test-golden-frame-stress.sh",
    "test:terminal-v4-visual-smoke": "sh scripts/run_terminal_failsafe_visual_smoke_v4.sh",
    "test:terminal-v4-canonical-multi-tf": "sh scripts/run_terminal_v4_canonical_multi_tf.sh",
    "test:xscale-viewport-guard": "node scripts/test-xscale-viewport-guard.js",
    "test:ohlcv-kernel-regression": "sh scripts/test-ohlcv-kernel-regression.sh",
    "test:risk-workspace": "node scripts/risk-workspace.integration.js",
    "test:e2e": "playwright test",
    "test:e2e:cancel-replace": "sh scripts/test-terminal-cancel-replace-e2e.sh",
    "test:e2e:cancel-replace-ui": "PLAYWRIGHT_TEST_PATHS='tests/e2e/terminal-cancel-replace-ui.spec.ts' sh scripts/test-terminal-cancel-replace-e2e.sh",
    "test:e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lightweight-charts": "4.2.3",
    "next": "15.5.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "^2.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
