[Unit]
Description=TXT controlled-live clean-cycle accrual guard (observe-only, gate scan + counter)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/txt
# READ-ONLY on trading: runs the gate scan, increments clean_cycles on a clean
# probe verdict, resets to 0 on any blocker. Never resets KS / trades / funds.
ExecStart=/opt/txt/scripts/controlled_live_clean_cycle_accrual.sh
StandardOutput=append:/opt/txt/logs/controlled-live-clean-cycles.log
StandardError=append:/opt/txt/logs/controlled-live-clean-cycles.err.log

[Install]
WantedBy=multi-user.target
