[Unit]
Description=TXT disk & compactor monitor (autonomous, Telegram alerts)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/txt
ExecStart=/opt/txt/scripts/monitor_txt_disk_compactor.sh
StandardOutput=append:/opt/txt/logs/txt-disk-compactor-monitor.log
StandardError=append:/opt/txt/logs/txt-disk-compactor-monitor.err.log

[Install]
WantedBy=multi-user.target
