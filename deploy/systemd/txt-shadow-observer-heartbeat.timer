[Unit]
Description=Run TXT shadow observer heartbeat every 2 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
# Episodes live ~9 min: keep the 2-min cadence tight (default accuracy could
# drift a scheduled check by up to a minute).
AccuracySec=10s
RandomizedDelaySec=0
Unit=txt-shadow-observer-heartbeat.service

[Install]
WantedBy=timers.target
